1:[[["$","link","css:/_next/static/css/marketing-refresh.DzYdQMFZ.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/marketing-refresh.DzYdQMFZ.css","data-rsc-css-href":"/_next/static/css/marketing-refresh.DzYdQMFZ.css"}],"$undefined"],["$","main",null,{"className":"as-secondary-page","children":[["$","section",null,{"className":"as-secondary-hero","children":["$","div",null,{"className":"container","children":[["$","span",null,{"className":"as-kicker","children":"Dúvidas objetivas"}],["$","h1",null,{"children":"Antes de instalar, saiba como funciona."}],["$","p",null,{"children":"Compatibilidade, licenças, internet, segurança e rotina explicadas sem letras miúdas."}],["$","span",null,{"className":"as-secondary-signal","aria-hidden":"true","children":[["$","i",null,{}],["$","i",null,{}],["$","i",null,{}]]}]]}]}],["$","section",null,{"className":"faq-section","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"faq-layout","children":[["$","aside",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Neste FAQ"}],["$","h2",null,{"children":"Informações essenciais"}],["$","p",null,{"children":"Do banco local ao convite do técnico: confira as regras que afetam a sua operação."}],["$","$L8",null,{"className":"btn btn-primary","href":"/guia","children":"Abrir o guia completo","prefetch":false}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","Posso escolher entre o layout antigo e o novo?",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Posso escolher entre o layout antigo e o novo?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim, na versão estável 10.2.0. Abra Configurações → Layout do aplicativo e escolha Layout clássico ou Layout novo. A mudança é visual: os dados, documentos e permissões são os mesmos. A preferência fica salva neste computador e pode ser desfeita a qualquer momento."}]]}],["$","details","Qual é a diferença entre a versão estável e a beta?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Qual é a diferença entre a versão estável e a beta?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A versão estável é a opção recomendada para o dia a dia. A beta reúne novidades em avaliação, como indica o sufixo da versão atual. Antes de mudar de canal, mantenha um backup externo validado. As imagens desta página usam dados fictícios."}]]}],["$","details","Para quem o aplicativo foi desenvolvido?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Para quem o aplicativo foi desenvolvido?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Para assistências técnicas, lojas de celulares e informática, técnicos independentes e negócios que precisam controlar entrada e saída de equipamentos, orçamentos, manutenção, documentos e garantia."}]]}],["$","details","Preciso instalar alguma coisa?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Preciso instalar alguma coisa?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"Sim. O aplicativo completo é instalado no computador Windows 64 bits da assistência. O instalador inclui os termos e prepara a estrutura local necessária."}]]}],["$","details","Em quais computadores o aplicativo funciona?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Em quais computadores o aplicativo funciona?"}],["$","i",null,{"className":"bi bi-plus-lg"}]]}],["$","p",null,{"children":"A versão atual é feita para Windows 10 ou Windows 11 em 64 bits. Ela é instalada no computador principal da assistência. O painel operacional completo fica nesse computador; o convite individual de avaliação pode ser aberto pelo técnico em outro computador ou celular durante as 24 horas de validade."}]]}],["$","details","Precisa de internet para trabalhar?",{"open":false,"children":[["$","summary",null,{"children":["$L19","$L1a"]}],"$L1b"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38"]}]]}],"$L39"]}]}]]}]]
